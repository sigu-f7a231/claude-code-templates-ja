{
  "mcpServers": {
    "remote-api": {
      "type": "http",
      "url": "${API_BASE_URL:-https://api.example.com}/mcp",
      "headers": {
        "Authorization": "Bearer ${API_KEY}"
      }
    },
    "local-tool": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "【mcp-server-package】"],
      "env": {
        "【SERVICE_API_KEY】": "${【SERVICE_API_KEY】}"
      }
    }
  }
}
